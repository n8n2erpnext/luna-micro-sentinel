{
  "name": "Micro Sentinel Alerts",
  "originalWorkflowId": "MSentinelAlerts20260905",
  "active": false,
  "sanitizedExport": true,
  "notes": "Template only. Credentials, host addresses, webhook IDs and operator identifiers deliberately removed.",
  "nodes": [
    {
      "id": "ms-alert-schedule",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ms-alert-poll",
      "name": "Poll Sentinel outbox",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        -80,
        0
      ],
      "parameters": {
        "authentication": "privateKey",
        "command": "=/usr/bin/python3 /home/ubuntu/services/micro-sentinel/bin/sentinel_alerts.py poll"
      }
    },
    {
      "id": "ms-alert-if",
      "name": "Has alert",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        140,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-alert",
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ms-alert-send",
      "name": "Send Sentinel alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        360,
        -80
      ],
      "parameters": {
        "chatId": "CONFIGURE_IN_N8N",
        "text": "={{ $json.stdout }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Poll Sentinel outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Sentinel outbox": {
      "main": [
        [
          {
            "node": "Has alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has alert": {
      "main": [
        [
          {
            "node": "Send Sentinel alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}
