      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -320,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "ms-review-a",
      "name": "Luna self review",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        -80,
        0
      ],
      "parameters": {
        "authentication": "privateKey",
        "command": "=/usr/bin/python3 /home/ubuntu/services/micro-sentinel/bin/sentinel_self_report.py"
      }
    },
    {
      "id": "ms-review-send-a",
      "name": "Send Luna self review",
