      "typeVersion": 1.2,
      "position": [
        160,
        -80
      ],
      "parameters": {
        "chatId": "CONFIGURE_IN_N8N",
        "text": "={{ $json.stdout }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      }
    },
    {
      "id": "ms-review-b",
